---
interface Props {
	compact?: boolean;
}
const { compact = true } = Astro.props;
---

<div class:list={["problem-divider", compact && "compact"]} role="separator" aria-label="题目分隔"></div>

<style>
  .problem-divider {
    width: 100%;
    height: 4px;
    margin-block: 1rem 1.5rem;
    position: relative;
  }
  .problem-divider::before {
    content: "";
    position: absolute;
    inset: 0;
    background: #a78bfa;
    transform: scaleY(1);
    transform-origin: center;
    transition: transform .22s cubic-bezier(.2, .7, .3, 1);
  }
  /* 卡片之后有内联加载脚本，使用同一题目 section 内的后续分隔线。 */
  :global(algorithm-card[data-reveal-active]) ~ .problem-divider::before {
    transform: scaleY(.25);
  }
  /* 收起时：按钮底边到 4px 线中心 = 10px 留白 + 2px 半线宽。 */
  :global(algorithm-card[article-level][compact][data-solution-open="false"]) ~ .problem-divider.compact {
    margin-block-start: 10px;
  }
  @media (prefers-reduced-motion: reduce) {
    .problem-divider::before { transition: none; }
  }
  .problem-divider.compact {
    margin-block: 10px 1.5rem;
  }

  /* MDX 会将每道题包在 section 中，同时兼容直接相邻的标题。 */
  :global(.problem-divider + :is(h1, h2, h3, h4, h5, h6)),
  :global(section:has(> .problem-divider:last-child) + section > :is(h1, h2, h3, h4, h5, h6):first-child) {
    margin-block-start: 1.5rem;
  }
</style>
