---
// MDX 内联彩色徽章组件
//
// 用法（.mdx）：
//   <Badge>新功能</Badge>
//   <Badge type="tip">提示</Badge>
//   <Badge type="warning">注意</Badge>
//
// type：default 为主题色，其余对应提示框色板
//   （tip / note / important / warning / caution），可选，默认 default

type BadgeType =
	| "default"
	| "tip"
	| "note"
	| "important"
	| "warning"
	| "caution";

interface Props {
	type?: BadgeType;
	class?: string;
}

const { type = "default", class: className } = Astro.props;

const colors: Record<BadgeType, string> = {
	default: "var(--primary)",
	tip: "var(--admonitions-color-tip)",
	note: "var(--admonitions-color-note)",
	important: "var(--admonitions-color-important)",
	warning: "var(--admonitions-color-warning)",
	caution: "var(--admonitions-color-caution)",
};
---

<span
	class:list={[
		"inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold whitespace-nowrap align-middle",
		"mdx-badge",
		className,
	]}
	style={`--badge-color: ${colors[type]}`}
>
	<slot />
</span>

<style>
	.mdx-badge {
		color: var(--badge-color);
		background: color-mix(in srgb, var(--badge-color) 12%, transparent);
	}
</style>
